---
/**
 * The threshold machine.
 *
 * Article V says two thirds of both Houses. It does not say two thirds of what.
 * That silence is the whole artifact: the toggle moves the base between the
 * full membership and the quorum, and the number a coalition needs falls by
 * half. The toggle is not a hypothetical -- the quorum reading is the holding of
 * the National Prohibition Cases, 253 U.S. 350 (1920), twenty-seven years before
 * G\u00f6del's hearing, and it is what the law actually was at the vantage.
 *
 * Motion here carries the argument. The threshold marker slides and the count
 * changes, which is the point being made. Nothing else on the page moves.
 *
 * With scripting off the reader gets a table of all four numbers, which is the
 * same information without the demonstration. Nothing is hidden behind the
 * interaction.
 */
import { num, fact } from '../lib/facts';
import Value from '../components/Value.astro';

const houseSize = num('house.size');
const senateSize = num('senate.size');
const houseQuorum = num('house.quorum');
const senateQuorum = num('senate.quorum');
const houseFull = num('threshold.house.full');
const housePropose = num('threshold.house.propose');
const senateFull = num('threshold.senate.full');
const senatePropose = num('threshold.senate.propose');

const chambers = [
  {
    key: 'house',
    name: 'House of Representatives',
    size: houseSize,
    quorum: houseQuorum,
    full: houseFull,
    propose: housePropose,
    sizeId: 'house.size',
    quorumId: 'house.quorum',
    fullId: 'threshold.house.full',
    proposeId: 'threshold.house.propose',
  },
  {
    key: 'senate',
    name: 'Senate',
    size: senateSize,
    quorum: senateQuorum,
    full: senateFull,
    propose: senatePropose,
    sizeId: 'senate.size',
    quorumId: 'senate.quorum',
    fullId: 'threshold.senate.full',
    proposeId: 'threshold.senate.propose',
  },
];

const holdingCase = fact('articlev.base.holding');
const origin = fact('articlev.base.origin');
---

<figure
  class="machine-fig"
  data-threshold-machine
  data-house-size={houseSize}
  data-senate-size={senateSize}
  data-house-full={houseFull}
  data-house-propose={housePropose}
  data-senate-full={senateFull}
  data-senate-propose={senatePropose}
>
  <figcaption class="head">
    <span class="smallcaps">Article V, the unstated denominator</span>
    <span class="sub">{fact('articlev.base.unstated').value}</span>
  </figcaption>

  <div class="needs-js controls">
    <fieldset>
      <legend class="visually-hidden">Which base does &#8220;two thirds of both Houses&#8221; divide?</legend>
      <label>
        <input type="radio" name="base" value="quorum" checked />
        <span>
          <strong>two thirds of a quorum</strong>
          <em>the 1947 law</em>
        </span>
      </label>
      <label>
        <input type="radio" name="base" value="full" />
        <span>
          <strong>two thirds of the full membership</strong>
          <em>the reading the Court rejected</em>
        </span>
      </label>
    </fieldset>
  </div>

  {chambers.map((c) => (
    <div class="chamber" data-chamber={c.key}>
      <div class="chamber-head">
        <span class="chamber-name">{c.name}</span>
        <span class="chamber-size tabular">
          <Value id={c.sizeId} bare /> seats
        </span>
      </div>

      <div class="bar" role="img" aria-label={`${c.name}: ${c.propose} of ${c.size} members suffice to propose an amendment when a bare quorum is present.`}>
        <div class="bar-track">
          <div
            class="bar-fill"
            data-fill
            style={`width: ${(c.propose / c.size) * 100}%`}
          ></div>
          <div
            class="bar-marker"
            data-marker
            style={`left: ${(c.propose / c.size) * 100}%`}
          ></div>
        </div>
        <div class="bar-scale">
          <span class="tabular">0</span>
          <span class="tabular">{c.size}</span>
        </div>
      </div>

      <p class="readout">
        <span class="figure tabular" data-readout>{c.propose}</span>
        <span class="readout-label">
          members suffice to propose an amendment
          <span class="readout-of tabular" data-readout-of>
            {Math.round((c.propose / c.size) * 100)}% of the chamber
          </span>
        </span>
      </p>

      <table class="no-js-only fallback">
        <caption class="visually-hidden">{c.name} thresholds under each reading of the base</caption>
        <thead>
          <tr>
            <th scope="col">Base</th>
            <th scope="col">Two thirds of it</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Quorum &#8212; the 1947 law</th>
            <td class="tabular">{c.propose}</td>
          </tr>
          <tr>
            <th scope="row">Full membership</th>
            <td class="tabular">{c.full}</td>
          </tr>
        </tbody>
      </table>
    </div>
  ))}

  <p class="holding">
    The lower number is not a hypothetical. It is the holding of the
    <cite>National Prohibition Cases</cite>, {holdingCase.value}, decided
    twenty&#8209;seven years before G&#246;del sat his examination, resolving the silence
    against the reading that would have made Article&nbsp;V harder to use. That
    holding rests in turn on an earlier and narrower case about the veto clause,
    <cite>{origin.value}</cite> &mdash; so the base of Article&nbsp;V&#8217;s fraction
    was never litigated on its own terms.
  </p>
</figure>

<script>
  /**
   * Progressive enhancement, not hydration. The figure is complete and correct
   * in the HTML; this only makes the base switchable so a reader can watch the
   * threshold move, which is the argument the numbers are making.
   *
   * Every number it writes came from data attributes the server rendered out of
   * data/facts.json. Nothing is computed from a literal typed here.
   */
  const root = document.querySelector<HTMLElement>('[data-threshold-machine]');

  if (root) {
    const read = (k: string): number => Number(root.dataset[k]);

    const chambers = [
      {
        el: root.querySelector<HTMLElement>('[data-chamber="house"]')!,
        size: read('houseSize'),
        quorum: read('housePropose'),
        full: read('houseFull'),
      },
      {
        el: root.querySelector<HTMLElement>('[data-chamber="senate"]')!,
        size: read('senateSize'),
        quorum: read('senatePropose'),
        full: read('senateFull'),
      },
    ];

    function apply(base: 'quorum' | 'full') {
      for (const c of chambers) {
        if (!c.el) continue;
        const n = base === 'quorum' ? c.quorum : c.full;
        const pct = (n / c.size) * 100;

        const fill = c.el.querySelector<HTMLElement>('[data-fill]');
        const marker = c.el.querySelector<HTMLElement>('[data-marker]');
        const readout = c.el.querySelector<HTMLElement>('[data-readout]');
        const readoutOf = c.el.querySelector<HTMLElement>('[data-readout-of]');
        const bar = c.el.querySelector<HTMLElement>('.bar');

        if (fill) fill.style.width = `${pct}%`;
        if (marker) marker.style.left = `${pct}%`;
        if (readout) readout.textContent = String(n);
        if (readoutOf) readoutOf.textContent = `${Math.round(pct)}% of the chamber`;
        if (bar) {
          bar.setAttribute(
            'aria-label',
            base === 'quorum'
              ? `${n} of ${c.size} members suffice to propose an amendment when a bare quorum is present.`
              : `${n} of ${c.size} members would be required if two thirds meant two thirds of the full membership.`,
          );
        }
        c.el.dataset.base = base;
      }
    }

    for (const input of root.querySelectorAll<HTMLInputElement>('input[name="base"]')) {
      input.addEventListener('change', () => {
        if (input.checked) apply(input.value as 'quorum' | 'full');
      });
    }
  }
</script>

<style>
  .machine-fig {
    margin: var(--space-lg) 0;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .head {
    display: block;
    margin-bottom: var(--space-md);
  }

  .head .smallcaps {
    display: block;
    font-family: var(--font-machine);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .head .sub {
    display: block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-top: 0.2em;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
  }

  label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    cursor: pointer;
  }

  label span {
    display: block;
  }

  label strong {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
  }

  label em {
    display: block;
    font-family: var(--font-machine);
    font-size: var(--text-xs);
    font-style: normal;
    color: var(--ink-faint);
    line-height: var(--leading-tight);
  }

  input[type='radio'] {
    accent-color: var(--ink);
    margin: 0;
    flex: none;
  }

  .chamber + .chamber {
    margin-top: var(--space-md);
  }

  .chamber-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: var(--text-sm);
  }

  .chamber-name {
    font-weight: var(--weight-medium);
  }

  .chamber-size {
    font-family: var(--font-machine);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .bar {
    margin-top: var(--space-2xs);
  }

  .bar-track {
    position: relative;
    height: 1.5rem;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
  }

  .bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--graphic);
    opacity: 0.28;
    transition: width var(--duration-slow) var(--ease);
  }

  /* The marker is the threshold. It is the thing that moves, and it is the only
     element on the site drawn in a status colour that is not a status -- it is
     drawn in ink, because a threshold is not a claim about evidence. */
  .bar-marker {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background: var(--ink);
    transition: left var(--duration-slow) var(--ease);
  }

  .bar-scale {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-machine);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-top: 2px;
  }

  .readout {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .readout .figure {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    min-width: 2.6ch;
  }

  .readout-label {
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    color: var(--ink-muted);
  }

  .readout-of {
    display: block;
    font-family: var(--font-machine);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .fallback {
    margin-top: var(--space-2xs);
  }

  .holding {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: var(--border-hair);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: var(--leading-snug);
  }
</style>
