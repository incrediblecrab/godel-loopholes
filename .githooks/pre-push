#!/bin/sh
# Refuse to push a site/pnpm-lock.yaml that CI's `pnpm install --frozen-lockfile` would reject.
#
# History. While the site used npm, the same failure reached CI three times: an incremental `npm install <pkg>` on macOS recorded only what macOS resolved and pruned the Linux-only WASM fallbacks (@emnapi/core, @emnapi/runtime, reached through @img/sharp-wasm32) out of package-lock.json, and `npm ci` on ubuntu-latest then failed with an EUSAGE dump that never named the cause. This hook ran a structural check of package-lock.json written for that case.
#
# The site now installs with pnpm, which resolves optional dependencies for every platform and records all of them in pnpm-lock.yaml, so that pruning mechanism is gone. What can still break CI is a lockfile out of step with package.json (a dependency edited without reinstalling) or a damaged one (a bad merge that drops an entry). `pnpm install --frozen-lockfile --lockfile-only` rejects both on any platform, without touching node_modules, including an entry missing for a package only Linux installs; both were tested by planting the defect.
#
# The same check is the first step of `npm run build` and an explicit step in the workflow. This is the layer that stops it leaving the machine at all.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# `git push --no-verify` bypasses it. CI runs the identical check, so the only thing bypassing buys is a slower, less legible failure.

set -eu

root=$(git rev-parse --show-toplevel)
cd "$root/site" 2>/dev/null || exit 0

# A guard that cannot run must fail, not pass. Silently skipping is how the npm lockfile got through the first two times.
if [ ! -f pnpm-lock.yaml ]; then
  echo "pre-push: site/pnpm-lock.yaml is missing, so the lockfile cannot be verified." >&2
  exit 1
fi
command -v pnpm >/dev/null 2>&1 || {
  echo "pre-push: pnpm is not on PATH, so the lockfile cannot be verified." >&2
  exit 1
}

if pnpm install --frozen-lockfile --lockfile-only --prefer-offline >/dev/null 2>&1; then
  exit 0
fi

pnpm install --frozen-lockfile --lockfile-only --prefer-offline >&2 || true

cat >&2 <<'MSG'
  PUSH BLOCKED — site/pnpm-lock.yaml does not match site/package.json, or is incomplete.

  CI runs `pnpm install --frozen-lockfile` on ubuntu-latest and would fail there.
  The detail above names the cause. To regenerate the lockfile:

      cd site && pnpm install

MSG
exit 1
