# Working notes — local only, never committed
todo.md
notes.md
scratch/
drafts/
*.local.md
*.wip.md

# Source material — cited, not redistributed
# Law review offprints, scanned archives, and book chapters stay on disk.
# What gets committed is the citation, a short quotation, and our own analysis.
sources/
*.pdf
*.epub
*.djvu
*.docx
*.tif
*.tiff
*.jpg
*.jpeg

# Saved web pages. A browser "complete page" save drops a sibling folder
# holding every asset on the page, which is how one article becomes 40MB.
*_files/
*.mhtml
*.webarchive

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
.netrc

# macOS
.DS_Store
._*

# Editors and agent state
.vscode/
.idea/
*.swp
.hidden-items.json
.copilot/
.claude/

# Rules above are deliberately broad. To ship a specific file anyway:
#     git add -f path/to/file.pdf
# Check any surprise with `git check-ignore -v <path>`, which names the
# exact line responsible.

# Python virtualenv (tooling, not source)
.venv/
venv/
__pycache__/
*.pyc

# Site build artefacts. The site is built on GitHub Actions from site/ and
# published as a Pages artefact, so no build output is committed. Fonts are
# self-hosted but come from npm packages under node_modules, which is why
# nothing here needs a woff2 exception.
node_modules/
site/dist/
site/.astro/
.astro/
